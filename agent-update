#!/usr/bin/env python3
"""
agent-update <done|blocked|testing|active|review> [note]

Call this from any agent session to update agents.csv.
Auto-detects the current tmux session name.

If no note is given on the command line, opens an nvim popup
(via tmux display-popup) for multiline editing.
"""
import csv, glob, subprocess, sys, os, tempfile
from datetime import datetime

AGENT_DIR  = os.environ.get("AGENT_DIR", os.path.expanduser("~/.agents"))
AGENT_FILE = os.environ.get("AGENT_FILE", os.path.join(AGENT_DIR, "agents.csv"))
AGENT_LOG  = os.environ.get("AGENT_LOG", os.path.join(AGENT_DIR, "agent-log.md"))
CHECKLIST_DIR = os.path.expanduser("~/notes/work_notes/testing-checklists")


def _norm_seg(s):
    """Normalize a filename segment to underscore convention (TECH-4748 -> TECH_4748)."""
    return s.replace("-", "_")


def checklist_stem(taskid, slug):
    """Standard testing-checklist filename stem: TECH_####_task_description
    (falls back to the underscored slug when there's no task ID)."""
    if taskid:
        return f"{_norm_seg(taskid)}_{_norm_seg(slug)}"
    return _norm_seg(slug)


def delete_checklists(taskid, slug):
    """Remove the task's testing checklist(s). Matches both the current
    underscore convention and legacy hyphen names."""
    patterns = []
    if taskid:
        patterns += [f"{_norm_seg(taskid)}*.md", f"{taskid}*.md"]  # new + legacy
    else:
        patterns += [f"{_norm_seg(slug)}.md", f"{slug}.md"]
    removed, seen = [], set()
    for pat in patterns:
        for p in glob.glob(os.path.join(CHECKLIST_DIR, pat)):
            if p in seen:
                continue
            seen.add(p)
            try:
                os.remove(p)
                removed.append(os.path.basename(p))
            except OSError:
                pass
    return removed

def main():
    valid = ('done', 'blocked', 'testing', 'active', 'review')
    if len(sys.argv) < 2 or sys.argv[1] not in valid:
        print(f"Usage: agent-update <{'|'.join(valid)}> [note]")
        sys.exit(1)

    status = sys.argv[1]

    if len(sys.argv) > 2:
        note = ' '.join(sys.argv[2:])
    else:
        # Open nvim in a tmux popup for multiline note editing
        tmp = tempfile.NamedTemporaryFile(suffix='.md', prefix='agent-note-', delete=False)
        tmp.close()
        try:
            subprocess.run(
                ["tmux", "display-popup", "-E", "-w", "80%", "-h", "60%",
                 "nvim", tmp.name],
                check=True
            )
            with open(tmp.name) as f:
                note = f.read().strip()
        finally:
            os.unlink(tmp.name)

        if not note:
            print("Aborted — empty note.")
            sys.exit(0)

    # Detect current tmux session
    try:
        session = subprocess.check_output(
            ["tmux", "display-message", "-p", "#S"],
            stderr=subprocess.DEVNULL, text=True
        ).strip()
    except Exception:
        print("ERROR: could not detect tmux session name")
        sys.exit(1)

    if not session:
        print("ERROR: empty session name")
        sys.exit(1)

    # Update agents.csv
    rows = []
    header = []
    found = False
    is_focus = False
    row_type = ''
    row_taskid = ''
    with open(AGENT_FILE) as f:
        reader = csv.reader(f)
        header = next(reader)
        rows.append(header)
        focus_idx = header.index('Focus') if 'Focus' in header else -1
        type_idx = header.index('Type') if 'Type' in header else -1
        taskid_idx = header.index('TaskID') if 'TaskID' in header else -1
        for row in reader:
            if len(row) > 3 and row[3] == session:
                found = True
                if focus_idx >= 0 and len(row) > focus_idx and row[focus_idx] == '1':
                    is_focus = True
                else:
                    row[0] = status
                if type_idx >= 0 and len(row) > type_idx:
                    row_type = row[type_idx]
                if taskid_idx >= 0 and len(row) > taskid_idx:
                    row_taskid = row[taskid_idx]
            rows.append(row)

    if not found:
        print(f"WARNING: session '{session}' not found in agents.csv — not tracked?")
        sys.exit(1)

    if not is_focus:
        with open(AGENT_FILE, 'w', newline='') as f:
            csv.writer(f).writerows(rows)

    # Append to log (always log, even in focus)
    today = datetime.now().strftime('%Y-%m-%d')
    with open(AGENT_LOG, 'a') as f:
        f.write(f"- [{today}] {session}: {note}\n")

    if is_focus:
        print(f"✓ {session} — focus mode (status unchanged, note logged)")
    else:
        print(f"✓ {session} → {status}")

    # Testing-checklist hint when transitioning to review/testing.
    # Analytics tasks are exempt — their deliverable is the analysis.
    if status in ('review', 'testing'):
        if row_type == 'analytics':
            print("  Type=analytics — SKIP testing checklist (deliverable is the analysis itself).")
        else:
            slug = session.removeprefix('zz-').removeprefix('z-')
            target = os.path.join(CHECKLIST_DIR, f"{checklist_stem(row_taskid, slug)}.md")
            print(f"  Write testing checklist to: {target}")
            print("  Format: '- [ ]' checkboxes, each a concrete step a user can run to test the feature.")

    # On completion, the checklist is no longer needed — remove it.
    if status == 'done' and not is_focus:
        slug = session.removeprefix('zz-').removeprefix('z-')
        removed = delete_checklists(row_taskid, slug)
        if removed:
            print(f"  Deleted testing checklist: {', '.join(removed)}")

if __name__ == '__main__':
    main()
